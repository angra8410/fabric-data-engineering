model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Fact_Covid_Daily","Dim_Location","Dim_Date"]

annotation PBI_ProTooling = ["TMDLView_Desktop","MCP-PBIModeling"]

ref table Fact_Covid_Daily
ref table Dim_Location
ref table Dim_Date
ref table 'Scale View'
ref table 'Case View'

ref cultureInfo en-US


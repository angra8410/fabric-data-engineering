<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Background Tracking, Notifications and Services -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <application
        android:name=".UniversalReadingApp"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_agenda"
        android:label="Universal Reading Tracker"
        android:roundIcon="@android:drawable/ic_menu_agenda"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RF-11 & ADR-011: NFC Tap-to-Track Handler for Physical Kindle -->
        <activity
            android:name=".presentation.nfc.NfcKindleActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="readingtracker" android:host="kindle" />
            </intent-filter>
        </activity>

        <!-- RF-01 & ADR-001: Passive Audible Media Listener Service -->
        <service
            android:name=".service.AudibleNotificationListenerService"
            android:label="Audible Playback Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- RF-03 & ADR-008: Kindle / Physical Reading Foreground Timer Service -->
        <service
            android:name=".service.KindleReadingTimerService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Quick Settings Tile for 1-Tap Kindle Reading Session -->
        <service
            android:name=".service.KindleQuickSettingsTileService"
            android:icon="@android:drawable/ic_menu_agenda"
            android:label="Leer en Kindle"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>

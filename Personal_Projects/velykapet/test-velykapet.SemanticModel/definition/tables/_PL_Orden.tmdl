/// Tabla de soporte para cascada P&L. Desconectada del modelo, usada solo como eje del Waterfall.
table _PL_Orden
	lineageTag: b440cdf0-8557-414a-8336-d7b9e91b1db9

	/// Medida switch para el Waterfall de P&L. Retorna el valor correcto según el paso seleccionado en _PL_Orden.
	measure 'Valor P&L' =
			VAR paso = SELECTEDVALUE(_PL_Orden[PL_Orden])
			RETURN
			    SWITCH(paso,
			        1, [Total Ventas],
			        2, -[Total Costo],
			        3, [Utilidad Bruta],
			        4, -[Total Gastos],
			        5, [Ganancia Neta]
			    )
		formatString: #,##0" COP"
		displayFolder: 📊 Rentabilidad
		lineageTag: 81770431-5e45-4030-b956-3567d2a902b8

	column PL_Paso
		lineageTag: 10ac5bb7-68f9-48fe-9bed-ca6256a2b98f
		isNameInferred
		sourceColumn: [PL_Paso]

	column PL_Orden
		lineageTag: a345d110-15f1-4f70-9251-6c1ed9e0401e
		isNameInferred
		sourceColumn: [PL_Orden]

	partition _PL_Orden = calculated
		mode: import
		source = DATATABLE("PL_Paso", STRING, "PL_Orden", INTEGER, {{"1. Ventas Totales", 1}, {"2. (-) Costo de Ventas", 2}, {"3. Utilidad Bruta", 3}, {"4. (-) Gastos Operativos", 4}, {"5. Ganancia Neta", 5}})


	measure Indice_Contratacion_Directa_Pct = ```
			
			DIVIDE ( 
			    SUM ( mart_transparencia_modalidades[monto_directo_cop] ), 
			    SUM ( mart_transparencia_modalidades[monto_total_cop] ), 
			    0 
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Measures
		lineageTag: 5de6a14b-4f26-45ad-94fe-529e870abfa0

		changedProperty = DisplayFolder

		changedProperty = Name

		changedProperty = FormatString

	measure Tasa_Pago_Efectivo_Pct_ = ```
			
			DIVIDE ( 
			    SUM ( mart_ejecucion_financiera[monto_pagado_cop] ), 
			    SUM ( mart_ejecucion_financiera[monto_contratado_cop] ), 
			    0 
			)
			
			```
		displayFolder: Measures
		lineageTag: 8e22777b-98d4-45ab-856d-ac8be3b0680d


	measure Inversion_Total_Billones = ```
			
			DIVIDE ( 
			    SUM ( mart_gasto_territorial[inversion_total_cop] ), 
			    1000000000000, 
			    0 
			)
			
			```
		displayFolder: Measures
		lineageTag: e9a2772f-6a5a-4603-ba83-ec3568b45e0d

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Contratos_ = ```
			

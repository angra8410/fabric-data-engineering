table FactOnlineSales
	lineageTag: af94a788-6e50-4364-bf3e-d60ee629760e
	sourceLineageTag: [dbo].[FactOnlineSales]

	measure 'Ventas Totales' = SUMX(FactOnlineSales, FactOnlineSales[SalesQuantity] * FactOnlineSales[UnitPrice])
		lineageTag: 3c4009c3-e924-4fa8-b884-a8b929f30376

	measure 'Ventas YTD' = TotalYTD([Ventas Totales], DimDate[Datekey])
		lineageTag: 3516d32f-fc9d-401a-b5b3-96fec2535cc8

	measure 'Ventas año Anterior' = CALCULATE([Ventas Totales], SAMEPERIODLASTYEAR(DimDate[Datekey]))
		lineageTag: d1ab612b-2d71-431d-a291-de1b78383612

	measure '% Ventas del Producto' = DIVIDE([Ventas Totales], Calculate([Ventas Totales], ALL(DimProduct)))
		lineageTag: 546bd950-0ce2-4a5a-b08a-099894c01c4b

		formatStringDefinition = "0.00%"


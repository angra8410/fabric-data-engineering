model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimCustomer","DimDate","DimProduct","DimProductCategory","DimProductSubcategory","DimStore","FactOnlineSales","RangeStart","RangeEnd"]

ref table DimCustomer
ref table DimDate
ref table DimProduct
ref table DimProductCategory
ref table DimProductSubcategory
ref table DimStore
ref table FactOnlineSales

ref cultureInfo en-US


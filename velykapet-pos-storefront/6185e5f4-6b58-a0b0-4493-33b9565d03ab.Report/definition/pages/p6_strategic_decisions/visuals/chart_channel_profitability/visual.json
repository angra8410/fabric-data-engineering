{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "chart_channel_profitability",
  "position": {
    "x": 20,
    "y": 130,
    "z": 5,
    "height": 270,
    "width": 600
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "sale_origin"
                }
              },
              "queryRef": "fact_sales.sale_origin",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "fact_sales.Total Revenue"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Gross Profit"
                }
              },
              "queryRef": "fact_sales.Gross Profit"
            }
          ]
        }
      }
    }
  }
}
{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "chart_category_margin",
  "position": {
    "x": 640,
    "y": 130,
    "z": 6,
    "height": 270,
    "width": 620
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_products"
                    }
                  },
                  "Property": "category"
                }
              },
              "queryRef": "dim_products.category",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Gross Profit"
                }
              },
              "queryRef": "fact_sales.Gross Profit"
            }
          ]
        }
      }
    }
  }
}
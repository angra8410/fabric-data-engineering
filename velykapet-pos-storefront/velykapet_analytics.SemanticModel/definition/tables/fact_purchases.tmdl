table fact_purchases
	lineageTag: c3d4e5f6-a7b8-9012-cdef-345678901234
	sourceLineageTag: [dbo].[fact_purchases]

	measure 'Total Purchases' = SUM(fact_purchases[purchase_amount])
		formatString: $#,##0.00
		displayFolder: 📦 Procurement
		lineageTag: pur-001

	measure 'Procurement Purchase Count' = COUNTROWS(fact_purchases)
		formatString: #,##0
		displayFolder: 📦 Procurement
		lineageTag: purcnt-001

	column purchase_id
		dataType: string
		sourceColumn: purchase_id

	column supplier
		dataType: string
		sourceColumn: supplier

	column purchase_amount
		dataType: double
		formatString: $#,##0.00
		sourceColumn: purchase_amount

	column purchase_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: purchase_date

	partition fact_purchases = entity
		mode: directLake
		source
			entityName: fact_purchases
			schemaName: dbo
			expressionSource: 'DirectLake - lh_velykapet_gold_dev'


{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.6.0/schema.json",
  "name": "chart_revenue_trend",
  "position": {
    "x": 20,
    "y": 150,
    "z": 6000,
    "width": 780,
    "height": 540,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "lineStackedColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "dim_date.Date",
              "nativeVisualMode": "Value"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "fact_sales.Total Revenue",
              "nativeVisualMode": "Value"
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Gross Margin %"
                }
              },
              "queryRef": "fact_sales.Gross Margin %",
              "nativeVisualMode": "Value"
            }
          ]
        }
      }
    },
    "visualCustomizations": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue & Gross Margin % Trend'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}

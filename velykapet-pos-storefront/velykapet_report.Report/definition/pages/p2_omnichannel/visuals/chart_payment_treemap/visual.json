{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.6.0/schema.json",
  "name": "chart_payment_treemap",
  "position": {
    "x": 20,
    "y": 420,
    "z": 4000,
    "width": 1240,
    "height": 270,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "treemap",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "payment_method"
                }
              },
              "queryRef": "fact_sales.payment_method",
              "nativeVisualMode": "Value"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "fact_sales.Total Revenue",
              "nativeVisualMode": "Value"
            }
          ]
        }
      }
    },
    "visualCustomizations": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Payment Method Revenue Distribution'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}

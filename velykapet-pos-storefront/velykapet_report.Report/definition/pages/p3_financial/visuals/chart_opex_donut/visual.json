{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.6.0/schema.json",
  "name": "chart_opex_donut",
  "position": {
    "x": 20,
    "y": 150,
    "z": 4000,
    "width": 600,
    "height": 540,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_expenses"
                    }
                  },
                  "Property": "category"
                }
              },
              "queryRef": "fact_expenses.category",
              "nativeVisualMode": "Value"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_expenses"
                    }
                  },
                  "Property": "Total Expenses"
                }
              },
              "queryRef": "fact_expenses.Total Expenses",
              "nativeVisualMode": "Value"
            }
          ]
        }
      }
    },
    "visualCustomizations": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'OpEx Breakdown by Category'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}

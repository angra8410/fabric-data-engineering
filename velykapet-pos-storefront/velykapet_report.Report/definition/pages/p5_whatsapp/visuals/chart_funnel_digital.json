{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.6.0/schema.json",
  "name": "chart_funnel_digital",
  "position": {
    "x": 20,
    "y": 150,
    "z": 3000,
    "width": 1240,
    "height": 540,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "funnel",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "sale_origin"
                }
              },
              "queryRef": "fact_sales.sale_origin",
              "nativeVisualMode": "Value"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Total Transactions"
                }
              },
              "queryRef": "fact_sales.Total Transactions",
              "nativeVisualMode": "Value"
            }
          ]
        }
      }
    },
    "visualCustomizations": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Digital Channel Funnel & Conversion'"
                }
              }
            },
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    }
  }
}

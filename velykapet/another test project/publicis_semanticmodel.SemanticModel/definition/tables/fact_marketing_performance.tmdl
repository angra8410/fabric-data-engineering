		lineageTag: 409ba678-59eb-466a-9feb-08e32a18ab70
		sourceLineageTag: Creative_Dimensions
		summarizeBy: none
		sourceColumn: Creative_Dimensions

		annotation SummarizationSetBy = Automatic

	column GA_Web_Source
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: ab8e156d-fcfb-454c-8c97-2cc0d31da34f
		sourceLineageTag: GA_Web_Source
		summarizeBy: none
		sourceColumn: GA_Web_Source

		annotation SummarizationSetBy = Automatic

	column Device_Category
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 19bacea6-1149-4d36-894a-f946e56d35cf
		sourceLineageTag: Device_Category
		summarizeBy: none
		sourceColumn: Device_Category

		annotation SummarizationSetBy = Automatic

	column Impressions
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: a45bc90e-bbb0-4003-80c3-8de11a620f0e
		sourceLineageTag: Impressions
		summarizeBy: sum
		sourceColumn: Impressions

		annotation SummarizationSetBy = Automatic

	column Clicks
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: 3f18f429-43eb-404f-9b46-5b5fa2208c3a
		sourceLineageTag: Clicks
		summarizeBy: sum
		sourceColumn: Clicks

		annotation SummarizationSetBy = Automatic

	column Sessions
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: 80643747-960f-4831-862f-272399f4eddc
		sourceLineageTag: Sessions
		summarizeBy: sum
		sourceColumn: Sessions

		annotation SummarizationSetBy = Automatic

	column Users
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		lineageTag: c5daa49c-dd59-4fcd-ac1e-08fe9161b9b6
		sourceLineageTag: Users
		summarizeBy: sum
		sourceColumn: Users

		annotation SummarizationSetBy = Automatic

	column Campaign_Group
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: 6633a9cc-c84e-48a5-a511-ffacc2019bd1
		sourceLineageTag: Campaign_Group
		summarizeBy: none
		sourceColumn: Campaign_Group

		annotation SummarizationSetBy = Automatic

	column Device_Category_DCM
		dataType: string
		sourceProviderType: varchar(8000)
		lineageTag: ef60d100-b6c2-4cb6-b3f9-6357970aa9d5
		sourceLineageTag: Device_Category_DCM
		summarizeBy: none
		sourceColumn: Device_Category_DCM

		annotation SummarizationSetBy = Automatic

	partition fact_marketing_performance = entity

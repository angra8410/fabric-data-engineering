table gold_fact_top_posts
	lineageTag: 3e73f0ff-802e-4d87-bf93-3963dcadaf59
	sourceLineageTag: [dbo].[gold_fact_top_posts]

	/// Total impressions from top posts
	measure 'Top Post Impressions' = SUM(gold_fact_top_posts[impressions])
		formatString: #,0
		displayFolder: Top Posts
		lineageTag: b9794c85-327f-407b-bcd3-af74dd9918ae

	/// Total engagements from top posts
	measure 'Top Post Engagements' = SUM(gold_fact_top_posts[engagements])
		formatString: #,0
		displayFolder: Top Posts
		lineageTag: e0543f22-128e-4bcb-91df-17f294433ba5

	/// Average engagement rate across top posts
	measure 'Avg Post Engagement Rate' = AVERAGE(gold_fact_top_posts[post_engagement_rate])
		formatString: 0.00%
		displayFolder: Top Posts
		lineageTag: 0403bc46-dbdd-4dcb-ad04-624b52cd7425

	/// Highest engagement rate among all posts
	measure 'Best Post Engagement Rate' = MAXX(VALUES(gold_fact_top_posts[post_title]), AVERAGE(gold_fact_top_posts[post_engagement_rate]))
		formatString: 0.00%
		displayFolder: Top Posts
		lineageTag: 41ddc1c4-1eeb-4f7d-8550-162a70338d74

	/// Number of distinct posts
	measure 'Post Count' = DISTINCTCOUNT(gold_fact_top_posts[post_url])
		formatString: #,0
		displayFolder: Top Posts
		lineageTag: 4ca170bc-490c-45d4-a09c-583a4058954f


		lineageTag: 617713a7-0a96-4bbc-ba4f-8ddbf5c677d3
		sourceLineageTag: total_new_followers
		summarizeBy: sum
		sourceColumn: total_new_followers

		annotation SummarizationSetBy = Automatic

	column weekly_engagement_rate
		dataType: double
		sourceProviderType: float
		lineageTag: 101a78d5-19c4-4c1c-88c5-f3f07a00a354
		sourceLineageTag: weekly_engagement_rate
		summarizeBy: sum
		sourceColumn: weekly_engagement_rate


table gold_fct_ventas
	lineageTag: 63cba065-2ba8-4b70-9525-aa4f436362ed
	sourceLineageTag: [dbo].[gold_fct_ventas]

	/// Suma total de ventas en COP
	measure 'Total Ventas' = SUM(gold_fct_ventas[total_venta_cop])
		formatString: #,##0" COP"
		displayFolder: 💰 Ventas
		lineageTag: c7bd4960-cafa-4e1b-b3c0-2447a99a36f3

	/// Unidades vendidas
	measure 'Total Cantidad' = SUM(gold_fct_ventas[cantidad])
		formatString: #,##0
		displayFolder: 💰 Ventas
		lineageTag: 6bedc868-4d1c-4048-8313-d40d2bbd423e

	/// Valor promedio por unidad vendida
	measure 'Ticket Promedio' = DIVIDE([Total Ventas], [Total Cantidad])
		formatString: #,##0" COP"
		displayFolder: 💰 Ventas
		lineageTag: 59638e90-4a0b-4d58-b985-739353c84be7

	/// Número de transacciones de venta
	measure '# Transacciones' = COUNTROWS(gold_fct_ventas)
		formatString: #,##0
		displayFolder: 💰 Ventas
		lineageTag: 490f6321-a3d6-4e80-8bfe-e3daa6116dc0

	/// Suma total de costos de los productos vendidos
	measure 'Total Costo' = SUM(gold_fct_ventas[costo_total_cop])
		formatString: #,##0" COP"
		displayFolder: 📦 Costos & Gastos
		lineageTag: 2b776546-b220-4596-974a-96eb7a801c91

	/// Costo unitario promedio ponderado
	measure 'Costo Unitario Prom' = DIVIDE([Total Costo], [Total Cantidad])
		formatString: #,##0" COP"
		displayFolder: 📦 Costos & Gastos
		lineageTag: 70bbdfd0-a59d-4f7f-9d45-cc4f824e0db9

	/// Utilidad bruta: ventas menos costo de ventas
	measure 'Utilidad Bruta' = SUM(gold_fct_ventas[utilidad_cop])
		formatString: #,##0" COP"
		displayFolder: 📈 Rentabilidad
		lineageTag: 405e0cf4-52a6-4b9d-bcbf-93633a9ff4bd

	/// Margen bruto como porcentaje de ventas
	measure 'Margen Bruto %' = DIVIDE([Utilidad Bruta], [Total Ventas])
		formatString: 0.0%
		displayFolder: 📈 Rentabilidad
		lineageTag: fe68e568-1e3f-48fa-942d-4c3eb743ec13

	/// Ganancia neta después de restar gastos operativos
	measure 'Ganancia Neta' = [Utilidad Bruta] - [Total Gastos]
		formatString: #,##0" COP"
		displayFolder: 📈 Rentabilidad
		lineageTag: 59e4aeff-2b4d-4a25-907f-c2a14c2e9ca2

	/// Margen neto como porcentaje de ventas totales
	measure 'Margen Neto %' = DIVIDE([Ganancia Neta], [Total Ventas])
		formatString: 0.0%
		displayFolder: 📈 Rentabilidad
		lineageTag: c399c21e-119f-44ff-b280-ba32e95ca6cd

	/// Relación entre gastos operativos y ventas totales
	measure 'Gastos sobre Ventas %' = DIVIDE([Total Gastos], [Total Ventas])
		formatString: 0.0%
		displayFolder: 📈 Rentabilidad
		lineageTag: 9e64a08d-b8a4-4260-8d51-8799b95c1612

	/// Ventas del mes anterior en el mismo contexto
	measure 'Ventas Mes Anterior' = CALCULATE([Total Ventas], DATEADD(dim_calendario[fecha_key], -1, MONTH))
		formatString: #,##0" COP"
		displayFolder: 🗓️ Tiempo
		lineageTag: b65d02d3-143a-4622-9968-0841beccb284

	/// Variación de ventas respecto al mes anterior en COP
	measure 'Variacion Ventas MoM' = [Total Ventas] - [Ventas Mes Anterior]
		formatString: #,##0" COP"
		displayFolder: 🗓️ Tiempo
		lineageTag: bac9109d-4066-4926-9552-a372df702b38

	/// Crecimiento porcentual respecto al mes anterior
	measure 'Crecimiento MoM %' = DIVIDE([Total Ventas] - [Ventas Mes Anterior], [Ventas Mes Anterior])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 🗓️ Tiempo
		lineageTag: 6ab47bfc-836f-44e5-9457-606f99909a4e

	/// Ventas acumuladas desde inicio del año hasta la fecha
	measure 'Ventas YTD' = CALCULATE([Total Ventas], DATESYTD(dim_calendario[fecha_key]))
		formatString: #,##0" COP"
		displayFolder: 🗓️ Tiempo
		lineageTag: 1ca54222-4419-4aae-ab99-3bc590981e07

	/// Ventas acumuladas del mes hasta la fecha
	measure 'Ventas MTD' = CALCULATE([Total Ventas], DATESMTD(dim_calendario[fecha_key]))
		formatString: #,##0" COP"
		displayFolder: 🗓️ Tiempo
		lineageTag: 12d1090e-106b-48c3-babe-0f4697338f84

	measure 'Ventas por Torre' =
			
			CALCULATE(
			    [Total Ventas],
			    ALLEXCEPT(gold_fct_ventas, gold_fct_ventas[logistica_torre])
			)
		displayFolder: 🏢 Logística
		lineageTag: 16142f23-7caf-49e3-a5f0-e3c3749dbc40

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Torre Líder' =
			
			CALCULATE(
			    FIRSTNONBLANK(gold_fct_ventas[logistica_torre], 1),
			    TOPN(1, VALUES(gold_fct_ventas[logistica_torre]), [Total Ventas], DESC)
			)
		displayFolder: 🏢 Logística
		lineageTag: 0b5c8b8b-734c-48d8-b897-5625bbf84b58

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Transacciones por Torre' =
			
			CALCULATE(
			    [# Transacciones],
			    ALLEXCEPT(gold_fct_ventas, gold_fct_ventas[logistica_torre])
			)
		formatString: 0
		displayFolder: 🏢 Logística
		lineageTag: e1aa32cb-0728-49f8-8da3-5ea86e8fdee6

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Ticket Promedio Torre' =
			
			DIVIDE([Total Ventas], [# Transacciones])
		displayFolder: 🏢 Logística
		lineageTag: c5799df9-5218-4990-937a-beb875598b4b

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ventas por Apto' =
			
			CALCULATE(
			    [Total Ventas],
			    ALLEXCEPT(gold_fct_ventas, gold_fct_ventas[logistica_apto])
			)
		displayFolder: 🏢 Logística
		lineageTag: a7858e90-f003-415c-b99f-ae4763d38b03

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Participacion Torre %' =
			
			DIVIDE([Total Ventas], CALCULATE([Total Ventas], ALL(gold_fct_ventas[logistica_torre])))
		displayFolder: 🏢 Logística
		lineageTag: 7224130d-4234-42c2-a049-77fd752d76df

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Aptos por Torre' =
			
			DISTINCTCOUNT(gold_fct_ventas[logistica_apto])
		formatString: 0
		displayFolder: 🏢 Logística
		lineageTag: 505cfc25-d95d-46b1-8dc1-02d20bf3b860

		changedProperty = DisplayFolder

		changedProperty = Name

	measure 'Unidades por Torre' =
			
			DISTINCTCOUNT(gold_fct_ventas[logistica_unidad])
		formatString: 0
		displayFolder: 🏢 Logística
		lineageTag: 22b3e512-3764-49cd-b4f4-6eeaeabfc2c7

		changedProperty = DisplayFolder

		changedProperty = Name


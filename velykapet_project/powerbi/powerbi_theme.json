{
  "name": "Velykapet Modern Dark Executive",
  "dataColors": [
    "#4F46E5",
    "#7C3AED",
    "#EC4899",
    "#10B981",
    "#F59E0B",
    "#06B6D4",
    "#8B5CF6",
    "#F43F5E"
  ],
  "background": "#0B0F19",
  "foreground": "#F9FAFB",
  "tableAccent": "#4F46E5",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#111827" } },
            "transparency": 0
          }
        ],
        "visualBorder": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F2937" } },
            "roundedCorners": 8
          }
        ],
        "visualHeader": [
          {
            "foreground": { "solid": { "color": "#F3F4F6" } }
          }
        ],
        "title": [
          {
            "fontColor": { "solid": { "color": "#F9FAFB" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#F9FAFB" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#9CA3AF" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "fontSize": 26
          }
        ],
        "trendLine": [
          {
            "show": true
          }
        ]
      }
    }
  }
}

table dim_products
	lineageTag: 07fa9fb0-9bc8-43d9-9fb8-ef951e70e28c
	sourceLineageTag: [dbo].[dim_products]

	measure 'Total Active SKUs' = DISTINCTCOUNT(dim_products[product_id])
		formatString: #,0
		lineageTag: m_active_skus

	measure 'Current Stock Units' = SUM(dim_products[current_stock])
		formatString: #,0
		lineageTag: m_stock_units

	measure 'Inventory Cost Valuation' = SUMX(dim_products, dim_products[current_stock] * dim_products[cost_price])
		formatString: \$#,0.00
		lineageTag: m_inv_cost_val

	measure 'Inventory Retail Valuation' = SUMX(dim_products, dim_products[current_stock] * dim_products[sale_price])
		formatString: \$#,0.00
		lineageTag: m_inv_retail_val

	measure 'Potential Inventory Margin' = [Inventory Retail Valuation] - [Inventory Cost Valuation]
		formatString: \$#,0.00
		lineageTag: m_pot_inv_margin

	measure 'Potential Inventory Margin %' = DIVIDE([Potential Inventory Margin], [Inventory Retail Valuation], 0)
		formatString: 0.0%
		lineageTag: m_pot_margin_pct

	measure 'Stock-Out Alert SKUs' = CALCULATE(DISTINCTCOUNT(dim_products[product_id]), dim_products[current_stock] <= 5)
		formatString: #,0
		lineageTag: m_stockout_alerts


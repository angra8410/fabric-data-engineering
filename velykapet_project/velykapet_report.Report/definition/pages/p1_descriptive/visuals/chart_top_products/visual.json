{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.3.0/schema.json",
  "name": "chart_top_products",
  "position": {
    "x": 650,
    "y": 200,
    "z": 13,
    "width": 610,
    "height": 505
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_products"
                    }
                  },
                  "Property": "product_name"
                }
              },
              "queryRef": "dim_products.product_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "fact_sales.Total Revenue"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Gross Margin %"
                }
              },
              "queryRef": "fact_sales.Gross Margin %"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Gross Profit"
                }
              },
              "queryRef": "fact_sales.Gross Profit"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_sales"
                    }
                  },
                  "Property": "Total Units Sold"
                }
              },
              "queryRef": "fact_sales.Total Units Sold"
            }
          ]
        }
      }
    }
  }
}

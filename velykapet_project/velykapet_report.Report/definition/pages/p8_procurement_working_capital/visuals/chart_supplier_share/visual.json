{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.3.0/schema.json",
  "name": "chart_supplier_share",
  "position": {
    "x": 20,
    "y": 130,
    "z": 5,
    "width": 600,
    "height": 270
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_purchases"
                    }
                  },
                  "Property": "supplier"
                }
              },
              "queryRef": "fact_purchases.supplier"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_purchases"
                    }
                  },
                  "Property": "Total Purchases"
                }
              },
              "queryRef": "fact_purchases.Total Purchases"
            }
          ]
        }
      }
    }
  }
}

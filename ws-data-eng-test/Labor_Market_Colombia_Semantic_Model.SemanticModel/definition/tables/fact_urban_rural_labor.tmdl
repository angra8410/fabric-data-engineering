table fact_urban_rural_labor
	lineageTag: dd8cca4a-8d9e-4e6b-8dc5-507debd1668f
	sourceLineageTag: [dbo].[fact_urban_rural_labor]

	/// Ocupados por año y zona (Urbano/Rural, columna geo_source). Esta tabla solo tiene grano anual (columna year), no fecha exacta, por lo que no esta relacionada con dim_date; filtrar usando su propio campo Year.
	measure 'Ocupados (Urbano-Rural)' = SUM(fact_urban_rural_labor[ocupados])
		formatString: #,##0
		displayFolder: 05 Urbano-Rural (anual)
		lineageTag: 9fb10c02-1ec4-4215-8dec-fb43ca5fa8c2

	/// Desocupados por año y zona (Urbano/Rural).
	measure 'Desocupados (Urbano-Rural)' = SUM(fact_urban_rural_labor[desocupados])
		formatString: #,##0
		displayFolder: 05 Urbano-Rural (anual)
		lineageTag: f5d90fca-449a-4fc5-be52-78aa84beb697

	/// Fuerza laboral por año y zona (Urbano/Rural).
	measure 'Fuerza Laboral (Urbano-Rural)' = SUM(fact_urban_rural_labor[fuerza_laboral])
		formatString: #,##0
		displayFolder: 05 Urbano-Rural (anual)
		lineageTag: 98a7ccef-701b-4c6a-8a18-9ad0725c4253

	/// Tasa de desempleo ponderada por año y zona = Desocupados / Fuerza Laboral.
	measure 'Tasa de Desempleo % (Urbano-Rural)' = DIVIDE([Desocupados (Urbano-Rural)], [Fuerza Laboral (Urbano-Rural)])
		formatString: 0.00%
		displayFolder: 05 Urbano-Rural (anual)
		lineageTag: bb699478-4dc5-4468-b41d-2b4641f31dd7


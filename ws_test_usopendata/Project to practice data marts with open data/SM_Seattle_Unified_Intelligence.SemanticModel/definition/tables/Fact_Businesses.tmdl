table Fact_Businesses
	lineageTag: 203cb98f-4f40-463d-accd-63e38fc784aa
	sourceLineageTag: [dbo].[Fact_Businesses]

	measure 'Total Businesses' = COUNTROWS(Fact_Businesses)
		formatString: #,##0
		displayFolder: Business Measures
		lineageTag: 848786a0-62a3-45af-8630-357d088a10a9

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Investment per Business' = DIVIDE([Total Investment], [Total Businesses])
		formatString: \$#,##0,"K";(\$#,##0,"K");\$0
		displayFolder: Business Measures
		lineageTag: 9e333e90-8b5c-4bff-a6ce-77866a28ff36

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Average Business Age' = AVERAGEX(Fact_Businesses, Fact_Businesses[age_in_years])
		formatString: 0.0 "Years"
		displayFolder: Business Measures
		lineageTag: 3c9b7402-998f-4cb1-80a2-ec72f0db3811

	measure 'Active Industries' = DISTINCTCOUNT(Fact_Businesses[industry_key])
		formatString: #,##0
		displayFolder: Business Measures
		lineageTag: 7a82ef41-2856-4cf2-8356-91b61df40cc4



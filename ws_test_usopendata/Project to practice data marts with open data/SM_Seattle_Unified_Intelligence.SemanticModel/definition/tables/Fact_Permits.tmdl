table Fact_Permits
	lineageTag: efa44825-3e65-459a-be9b-4162f98a483f
	sourceLineageTag: [dbo].[Fact_Permits]

	measure 'Total Permits' = COUNTROWS(Fact_Permits)
		formatString: 0
		displayFolder: Permit Measures
		lineageTag: 758ea406-db1a-4eb6-b4b1-023627d87a54

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Total Investment' = SUM(Fact_Permits[est_project_cost])
		formatString: \$#,##0,,,"B";(\$#,##0,,,"B");\$0
		displayFolder: Permit Measures
		lineageTag: 01002513-42f8-4f29-ad84-6ebac57bd546

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Net Housing Units Added' = ```
			
			    SUM(Fact_Permits[housing_units_added]) - SUM(Fact_Permits[housing_units_removed])
			```
		formatString: +#,##0;-#,##0;0
		displayFolder: Permit Measures
		lineageTag: a2aa5b8f-0709-44db-b638-c8ca539caf7c

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Average Days to Issue' = ```
			
			AVERAGEX(
			    FILTER(
			        Fact_Permits, 
			        NOT(ISBLANK(Fact_Permits[issued_date])) && 
			        NOT(ISBLANK(Fact_Permits[applied_date]))
			    ),
			    DATEDIFF(Fact_Permits[applied_date], Fact_Permits[issued_date], DAY)
			)
			```
		formatString: 0 "Days"
		displayFolder: Permit Measures
		lineageTag: f634145d-18a7-4fdf-9eff-a8b010817045

		changedProperty = Name

		changedProperty = DisplayFolder

